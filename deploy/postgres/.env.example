# 本地 PostgreSQL 连接配置（仅用于本机开发，请勿用于生产）
# 复制为 .env 后生效：cp .env.example .env
# 不创建 .env 时，docker-compose.yml 内的默认值同样可用。
# 修改后需重启容器：docker compose -f deploy/postgres/docker-compose.yml down && docker compose -f deploy/postgres/docker-compose.yml up -d
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb